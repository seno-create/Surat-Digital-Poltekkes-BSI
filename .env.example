# --- Database (Supabase / Neon) ---
# URL koneksi pooled (untuk aplikasi di Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# URL koneksi langsung / non-pooled (untuk migrasi)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth ---
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"
# URL aplikasi, mis. https://surat-dinas.vercel.app (lokal: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# --- Google Drive (Shared Drive + service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL="surat-dinas@nama-project.iam.gserviceaccount.com"
# Private key dari file JSON service account. Tulis dalam satu baris dengan \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ID Shared Drive (dari URL: drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_ROOT_ID="0AAbbCCddEEffUk9PVA"

# --- Identitas instansi (dipakai di kop cetak & penomoran) ---
INSTANSI_NAMA="Politeknik Kesehatan"
INSTANSI_ALAMAT="Jl. Contoh No. 1, Kota"
# Format nomor surat keluar. Token: {urut} {klasifikasi} {unit} {bulan_romawi} {bulan} {tahun}
FORMAT_NOMOR_SURAT="{urut}/{klasifikasi}/{unit}/{bulan_romawi}/{tahun}"

# Akun admin awal yang dibuat oleh seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="GantiPassword123!"
